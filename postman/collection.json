{
  "info": {
    "_postman_id": "8d4858a6-6c9f-499e-a3ae-7772dae6732e",
    "name": "Expense-Tracker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "25449788"
  },
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "Fetch CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the response JSON",
                  "const responseData = pm.response.json();",
                  "",
                  "// Save the csrfToken into your environment variables automatically",
                  "if (responseData.csrfToken) {",
                  "    pm.environment.set(\"csrfToken\", responseData.csrfToken);",
                  "    console.log(\"CSRF Token saved:\", responseData.csrfToken);",
                  "}",
                  "",
                  "// Basic assertion",
                  "pm.test(\"Fetched CSRF Token Successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(responseData.csrfToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": []
            },
            "url": {
              "raw": "{{baseURL}}/api/auth/csrf",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "csrf"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login Request Successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Redirect URL is present\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.url).to.exist;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "csrfToken",
                  "value": "{{csrfToken}}",
                  "type": "text",
                  "uuid": "3c7681c3-adc7-4f9e-82ab-ceb8fd1b93c3"
                },
                {
                  "key": "email",
                  "value": "{{test_user_email}}",
                  "type": "text",
                  "uuid": "b434548c-2a06-4171-ae6f-9968ebea2370"
                },
                {
                  "key": "password",
                  "value": "{{test_user_password}}",
                  "type": "text",
                  "uuid": "9831678f-4c12-4972-ba34-540b19c988c1"
                },
                {
                  "key": "json",
                  "value": "true",
                  "type": "text",
                  "uuid": "a4541a1e-a92c-4329-af07-d0dfbe3258fa"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/api/auth/callback/credentials",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "callback", "credentials"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Account Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains expected user name\", function () {",
                  "    pm.expect(pm.response.text()).to.include(pm.environment.get(\"test_account_name\")); ",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/main/account",
              "host": ["{{baseURL}}"],
              "path": ["main", "account"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "expenses",
      "item": [
        {
          "name": "Fetch User ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the response JSON",
                  "const responseData = pm.response.json();",
                  "",
                  "// Save the user id into your environment variables automatically",
                  "if (responseData.user.id) {",
                  "    pm.environment.set(\"test_user_id\", responseData.user.id);",
                  "    console.log(\"User ID saved:\", responseData.user.id);",
                  "}",
                  "",
                  "// Basic assertion",
                  "pm.test(\"Fetched User ID Successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(responseData.user.id).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/auth/session",
              "host": ["{{baseURL}}"],
              "path": ["api", "auth", "session"]
            }
          },
          "response": []
        },
        {
          "name": "Create Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Response body contains an id, amount and title\", function () {",
                  "    pm.expect(responseData).to.have.property(\"id\"); //expense id",
                  "    pm.expect(responseData.id).to.be.a(\"string\").and.not.empty;",
                  "    ",
                  "    pm.expect(responseData).to.have.property(\"amount\"); // expense amount",
                  "    pm.expect(responseData.amount).to.eql(4);",
                  "",
                  "    pm.expect(responseData).to.have.property(\"title\"); // expense title",
                  "    pm.expect(responseData.title).to.eql(\"Coffee\");",
                  "});",
                  "",
                  "// Save the expense id into your environment variables automatically",
                  "if (responseData.id) {",
                  "    pm.environment.set(\"test_expense_id\", responseData.id);",
                  "    console.log(\"Expense ID saved:\", responseData.id);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{test_user_id}}\",\n    \"title\": \"Coffee\",\n    \"amount\": 4,\n    \"category\": \"DINING\",\n    \"date\": \"2026-08-14\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/api/expenses",
              "host": ["{{baseURL}}"],
              "path": ["api", "expenses"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200 or 204\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{test_user_id}}\",\n    \"title\": \"Coffee\",\n    \"amount\": 4,\n    \"category\": \"DINING\",\n    \"date\": \"2026-08-14\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/api/expenses/{{test_expense_id}}",
              "host": ["{{baseURL}}"],
              "path": ["api", "expenses", "{{test_expense_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Expense is Deleted",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns 404 when trying to access or delete the deleted expense\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "// Clear the env for test_expense_id",
                  "if (pm.response.code === 404) {",
                  "    pm.environment.set(\"test_expense_id\", \"\");",
                  "    console.log(\"test_expense_id value cleared from environment.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{test_user_id}}\",\n    \"title\": \"Coffee\",\n    \"amount\": 4,\n    \"category\": \"DINING\",\n    \"date\": \"2026-08-14\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/expenses/{{test_expense_id}}",
              "host": ["{{baseURL}}"],
              "path": ["api", "expenses", "{{test_expense_id}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
